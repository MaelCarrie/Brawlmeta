# Clé de l'API officielle : https://developer.brawlstars.com
# (elle doit autoriser l'adresse IP publique de la machine qui lance `npm run collect`)
# Une ou plusieurs clés séparées par des virgules (une par réseau : maison, école…)
BS_API_KEY=

# Types de parties à collecter (soloRanked = Classé, ranked = parties en trophées)
BS_BATTLE_TYPES=soloRanked,ranked
# Classements utilisés comme point de départ (global + codes pays)
BS_COUNTRIES=global,fr,us,br,es,de,it,mx,kr,jp,ru,tr,pl,gb,ca
# Nombre max de joueurs analysés par collecte
BS_MAX_PLAYERS=2000
BS_CONCURRENCY=8
# Durée de conservation des parties (jours)
BS_RETENTION_DAYS=60
# Période affichée par défaut sur le site (3, 7, 14 ou 30)
BS_DEFAULT_DAYS=14
